# OpenRouter API configuration.
# Copy this file to `.env` and fill in your real key. Never commit
# `.env` to source control — it is already git-ignored.
#
# Get your API key at https://openrouter.ai/keys

OPENROUTER_API_KEY=test-key

# Optional overrides. The defaults below are what the app uses
# when these are blank or missing.
#
# NOTE: The app no longer reads an `OPENROUTER_MODEL` env var —
# the AI model is selected by the user from Settings → AI model
# and persisted in SharedPreferences. The bundled default is
# `inclusionai/ling-2.6-flash` and is used when no preference
# is stored yet.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_REFERER=https://kashf-lite.app
OPENROUTER_APP_TITLE=KASHF Lite
