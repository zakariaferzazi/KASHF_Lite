rules_version = '2';

// Firestore security rules for KASHF Lite.
//
// The two collections referenced by `lib/services/news/news_content_repository.dart`
// are deliberately world-writable / world-readable:
//
//   newsContent/{locale}/topics/{docId}    -> trending news feeds
//   aiContent/{kind}/regions/{docId}       -> AI-generated payloads
//
// Why public?
//   * The content is the same for every user — there is no per-user data here.
//   * Reads are also public so a logged-out user can hydrate the app on first
//     launch (the only user-specific data, completed investigations, lives in
//     `users/{uid}/investigations` and is already covered by its own rules).
//   * The 24-hour refresh policy is enforced in code, not in rules, so
//     opening the database to the public cannot allow an attacker to
//     downgrade freshness faster than the policy already permits.
//
// If you ever introduce per-user content under these paths (e.g. private
// reading lists) tighten the rules below accordingly.
service cloud.firestore {
  match /databases/{database}/documents {

    // --- News content (Google News + persisted per-locale feeds) ---
    match /newsContent/{locale}/topics/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // --- AI-generated content (home pulse / market / explore) ---
    match /aiContent/{kind}/regions/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // --- Existing per-user investigation archive ---
    // Documents live under users/{uid}/investigations/{docId}. Only the
    // owning authenticated user may read or write their own slice.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      // The admin account (nawaff89@gmail.com) may read every user's
      // investigations so the "System Overview" can show all users'
      // rows. Reads only, never writes, to other users' data.
      allow read: if request.auth != null
                  && request.auth.token.email != null
                  && request.auth.token.email.lower()
                     == 'nawaff89@gmail.com';
    }

    // Collection-group rule backing the admin "System Overview", which
    // streams across users/{anyUid}/investigations via
    // `collectionGroup('investigations')`. Denied for everyone except
    // the admin; the admin also inherits the allow above for reads.
    match /{path=**}/investigations/{docId} {
      allow read: if request.auth != null
                  && request.auth.token.email != null
                  && request.auth.token.email.lower()
                     == 'nawaff89@gmail.com';
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
